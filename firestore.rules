rules_version = '2';

// =====================================================================
// Firestore Security Rules — Link Locker
// Paste this into Firebase Console → Firestore Database → Rules
// =====================================================================
//
// SECURITY MODEL NOTE:
// This app is 100% client-side (no backend/Cloud Function). The public
// unlock flow is allowed to increment a link's `unlockCount` by exactly
// +1 per write, and to write a device-info log entry — nothing else.
// A session-token gate (requiring server-timestamped proof that both ad
// steps were watched, with a real time gap between them) was tried, but
// its multiple sequential round-trip writes proved unreliable on slow/
// unstable mobile connections and caused real unlocks to go uncounted —
// a worse outcome than the fraud risk it guarded against. So this is a
// deliberate, accepted tradeoff: someone willing to open devtools and
// call these same writes directly could inflate the count. True
// elimination of that risk requires moving the final unlock step behind
// a Cloud Function.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // links collection
    //   - Anyone can READ a single link by ID (needed by index.html to
    //     show ads/title and, after unlock, the real URL) — but only
    //     documents can be fetched by exact ID; listing/browsing all
    //     links is blocked for non-admins.
    //   - Only authenticated admins can CREATE / UPDATE (most fields) /
    //     DELETE links, EXCEPT the public unlock flow is allowed to
    //     increment `unlockCount` by exactly +1 and nothing else.
    // ---------------------------------------------------------------
    match /links/{linkId} {
      allow get: if true; // fetch by known ID (index.html)
      allow list: if request.auth != null; // admin dashboard table

      allow create, delete: if request.auth != null;

      allow update: if request.auth != null
        || (
          // Public "unlock" increments: ONLY unlockCount may change,
          // and only by exactly +1 per write.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlockCount']) &&
          request.resource.data.unlockCount == resource.data.unlockCount + 1
        );
    }

    // ---------------------------------------------------------------
    // unlocks collection — write-only log used for "Today's Unlocks",
    // the admin device-breakdown stat, and per-link unlock history.
    // ---------------------------------------------------------------
    match /unlocks/{unlockId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['linkId', 'timestamp', 'deviceType', 'os', 'browser']
        )
        && request.resource.data.linkId is string
        && request.resource.data.deviceType is string
        && request.resource.data.os is string
        && request.resource.data.browser is string;
      allow read: if request.auth != null; // admin dashboard + history
      allow update, delete: if false;
    }
  }
}
