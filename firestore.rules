rules_version = '2';

// =====================================================================
// Firestore Security Rules — Link Locker
// Paste this into Firebase Console → Firestore Database → Rules
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // links collection
    //   - Anyone can READ a single link by ID (needed by index.html to
    //     show ads/title and, after unlock, the real URL) — but only
    //     documents can be fetched by exact ID; listing/browsing all
    //     links is blocked for non-admins.
    //   - Only authenticated admins can CREATE / UPDATE / DELETE links,
    //     EXCEPT the public unlock flow is allowed to increment
    //     `unlockCount` only (via a narrow update rule).
    // ---------------------------------------------------------------
    match /links/{linkId} {
      allow get: if true; // fetch by known ID (index.html)
      allow list: if request.auth != null; // admin dashboard table

      allow create, delete: if request.auth != null;

      allow update: if request.auth != null
        || (
          // Public "unlock" increments are restricted to ONLY the
          // unlockCount field changing by exactly +1.
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unlockCount']) &&
          request.resource.data.unlockCount == resource.data.unlockCount + 1
        );
    }

    // ---------------------------------------------------------------
    // unlocks collection — write-only log used for "Today's Unlocks"
    // ---------------------------------------------------------------
    match /unlocks/{unlockId} {
      allow create: if request.resource.data.keys().hasOnly(['linkId', 'timestamp'])
        && request.resource.data.linkId is string;
      allow read: if request.auth != null; // admin dashboard stat
      allow update, delete: if false;
    }
  }
}
